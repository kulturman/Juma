{
  "name": "juma",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest.json --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --watch",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-all.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration": "dotenv -e .env -- npm run typeorm -- migration:run -d src/sharedKernel/adapters/primary/config/typeorm-migrations.config.ts",
    "migration:test": "npm run create:db-test && dotenv -e .env.test -- npm run typeorm -- migration:run -d src/sharedKernel/adapters/primary/config/typeorm-migrations.config.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/sharedKernel/adapters/primary/config/typeorm-migrations.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/sharedKernel/adapters/primary/config/typeorm-migrations.config.ts",
    "fixtures": "dotenv -e .env -- fixtures load ./fixtures -d ./dist/sharedKernel/adapters/primary/config/typeorm-migrations.config.js",
    "fixtures:test": "dotenv -e .env.test -- fixtures load ./fixtures -d ./dist/sharedKernel/adapters/primary/config/typeorm-migrations.config.js",
    "create:db-test": "docker exec -it juma-mysql mysql -u root -pjuma -e \"CREATE SCHEMA IF NOT EXISTS jumatest\"",
    "dev": "concurrently \"npm run start:dev\" \"npm start --prefix frontend\" "
  },
  "dependencies": {
    "@nestjs/bull": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^0.27.2",
    "bcrypt": "^5.0.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "directory-tree": "^3.3.0",
    "dotenv": "^16.0.1",
    "dotenv-cli": "^5.1.0",
    "ioredis": "^5.3.1",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "purify-ts": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuidv4": "^6.2.13",
    "webtorrent": "^1.8.22"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/mariadb": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/bull": "^3.15.8",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.194",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^3.0.6",
    "@types/passport-local": "^1.0.34",
    "@types/supertest": "^7.2.1",
    "@types/webtorrent": "^0.109.3",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "concurrently": "^7.2.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.20",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-fixtures-cli": "^4.1.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24.9"
  }
}
